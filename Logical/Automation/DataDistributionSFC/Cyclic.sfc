PROGRAM _CYCLIC
<?AutomationStudio FileVersion="4.9"?>
INITIAL_STEP START:
(* @LANGUAGE := 'st' *)

SFCReset := FALSE;
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
TRANSITION FROM START TO Step1:=
TRUE
END_TRANSITION
(* @SFCNOJUMP := 'Step1' *)
IEC_STEP Step1:
FunctionblockCalls(S);
Step1Active(N);
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
task.internal.completedLayers := FALSE;
task.internal.completedCycles := 0;

END_ACTION
TRANSITION FROM Step1 TO CheckBuildInfo:=
OP_START_DISTRIBUTION
END_TRANSITION
(* @SFCNOJUMP := 'CheckBuildInfo' *)
STEP CheckBuildInfo:
(* @LANGUAGE := 'st' *)

gPrintJobManagement.currentState.currentLayerNumber := 1;
IF gPrintJobManagement.currentState.buildInfoCheckValid THEN
	StepDone := TRUE;
ELSE
	//TODO:	task.status.statusID := SOME_ERROR;
	StepError := TRUE;
END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM CheckBuildInfo TO UpdateNextLayer:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'UpdateNextLayer' *)
STEP UpdateNextLayer:
(* @LANGUAGE := 'st' *)
task.internal.nextLayerNumber  := gPrintJobManagement.currentState.currentLayerNumber + 1;	



// Incrementing to the next layer is only permitted as long as the last layer has yet to be printed.
IF ( task.internal.nextLayerNumber <= gPrintJobManagement.currentState.numberOfLayers ) AND gPrintJobManagement.currentState.openAndCloseLayers THEN
	
	StepDoneOpenLayer := TRUE;
	
ELSIF ( task.internal.nextLayerNumber <= gPrintJobManagement.currentState.numberOfLayers ) THEN
	
	StepDone := TRUE;
	
		
ELSE


	task.internal.completedCycles := task.internal.completedCycles + 1;
	CycleDone := TRUE;

	task.status.statusMessage := 'Invalid Next layer';

	//Can't print the requested layer, since it isn't the next layer
	//vfAlarmEdge( gPrintJobManagement.alarms.components, gPrintJobManagement.alarms.InvalidCurrentLayer_AL0026 );
					
END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
StepDoneOpenLayer := FALSE;
CycleDone := FALSE;
(* TODO: Insert Program *)
END_ACTION
TRANSITION FROM UpdateNextLayer TO UpdateNextLayerglobally:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'UpdateNextLayerglobally' *)
TRANSITION FROM UpdateNextLayer TO UpdateNextLayerglobally1:=
StepDoneOpenLayer
END_TRANSITION
(* @SFCNOJUMP := 'UpdateNextLayerglobally1' *)
STEP UpdateNextLayerglobally1:
(* @LANGUAGE := 'st' *)
gPrintJobManagement.currentState.nextLayerNumber := task.internal.nextLayerNumber;
gPrintJobManagement.currentState.currentLayerNumber := gPrintJobManagement.currentState.nextLayerNumber;


StepDone := TRUE;
			
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM UpdateNextLayerglobally1 TO RequestLayerFileTranf1:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'RequestLayerFileTranf1' *)
STEP RequestLayerFileTranf1:
(* @LANGUAGE := 'st' *)

buildDistCommand.Command := gBuildDistributorApi.commands.distributeLayerFile;
buildDistCommand.Execute := TRUE;
buildDistCommand();

IF buildDistCommand.Done OR  gPrintJobManagement.status.distributionLayerComplete OR (gOpcData_FromBuildPC.CurrentDistributionLayer = gOpcData_ToBuildPC.CurrentPrintLayer) THEN
	
	StepDone := TRUE;
	gPrintJobManagement.status.distributionLayerComplete := FALSE;
	buildDistCommand.Execute := FALSE;
	buildDistCommand();
ELSIF buildDistCommand.Error OR buildDistCommand.Aborted THEN
	
	StepDone := FALSE;
	StepError := TRUE;
	buildDistCommand.Execute := FALSE;
	buildDistCommand();

END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM RequestLayerFileTranf1 TO openLayer1:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'openLayer1' *)
STEP openLayer1:
(* @LANGUAGE := 'st' *)
Command.Command :=  gVFLCR.command.openLayer;
//TODO: VALIDATE THIS  IS CORRECT!
openLayerParameters.parameters.selectedBuildLayout :=	gPrintJobManagement.currentState.buildLayout;
openLayerParameters.parameters.selectedLayer :=			gPrintJobManagement.currentState.currentLayerNumber;
openLayerParameters.parameters.selectedPrintNumber :=	gPrintJobManagement.currentState.printNumber;
Command.pParameters := ADR(openLayerParameters); 
Command.sParameters := SIZEOF(openLayerParameters);
Command.Execute := TRUE;
Command();
IF Command.Done THEN
	StepDone := TRUE;
	Command.Execute := FALSE;
	Command();
ELSE
	StepDone := FALSE;	
END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM openLayer1 TO abortLayer1:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'abortLayer1' *)
STEP abortLayer1:
(* @LANGUAGE := 'st' *)
Command.Command :=  gVFLCR.command.abortLayer;
Command.Execute := TRUE;
Command();
IF Command.Done THEN
	StepDone := TRUE;
	Command.Execute := FALSE;
	Command();
ELSE
	StepDone := FALSE;	
END_IF

END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM abortLayer1 TO wait1:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'wait1' *)
STEP wait1:
(* @LANGUAGE := 'st' *)
task.internal.nextLayerTimer.PT := T#5s;
task.internal.nextLayerTimer.IN := TRUE;
task.internal.nextLayerTimer(); 
			
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
task.internal.nextLayerTimer.IN := FALSE;
task.internal.nextLayerTimer();
(* TODO: Insert Program *)
END_ACTION
TRANSITION FROM wait1 TO UpdateNextLayer:=
task.internal.nextLayerTimer.Q
END_TRANSITION
(* @SFCISJUMP := 'UpdateNextLayer' *)
TRANSITION FROM UpdateNextLayer TO CompletedAllLayers:=
CycleDone
END_TRANSITION
(* @SFCNOJUMP := 'CompletedAllLayers' *)
STEP CompletedAllLayers:
(* @LANGUAGE := 'st' *)
//task.internal.completedLayers := TRUE;

//IF task.command.closePopup THEN
		
	//task.internal.completedLayers := FALSE;
StepDone := TRUE;
gPrintJobManagement.currentState.currentLayerNumber := 0;
		
//END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
TRANSITION FROM CompletedAllLayers TO Step1:=
StepDone
END_TRANSITION
(* @SFCISJUMP := 'Step1' *)
STEP UpdateNextLayerglobally:
(* @LANGUAGE := 'st' *)
gPrintJobManagement.currentState.nextLayerNumber := task.internal.nextLayerNumber;
gPrintJobManagement.currentState.currentLayerNumber := gPrintJobManagement.currentState.nextLayerNumber;


StepDone := TRUE;
			
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM UpdateNextLayerglobally TO RequestLayerFileTranf:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'RequestLayerFileTranf' *)
STEP RequestLayerFileTranf:
(* @LANGUAGE := 'st' *)

buildDistCommand.Command := gBuildDistributorApi.commands.distributeLayerFile;
buildDistCommand.Execute := TRUE;
buildDistCommand();

IF buildDistCommand.Done OR  gPrintJobManagement.status.distributionLayerComplete OR (gOpcData_FromBuildPC.CurrentDistributionLayer = gOpcData_ToBuildPC.CurrentPrintLayer) THEN
	
	StepDone := TRUE;
	gPrintJobManagement.status.distributionLayerComplete := FALSE;
	buildDistCommand.Execute := FALSE;
	buildDistCommand();
ELSIF buildDistCommand.Error OR buildDistCommand.Aborted THEN
	
	StepDone := FALSE;
	StepError := TRUE;
	buildDistCommand.Execute := FALSE;
	buildDistCommand();

END_IF
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
StepDone := FALSE;
END_ACTION
TRANSITION FROM RequestLayerFileTranf TO wait:=
StepDone
END_TRANSITION
(* @SFCNOJUMP := 'wait' *)
STEP wait:
(* @LANGUAGE := 'st' *)
task.internal.nextLayerTimer.PT := T#5s;
task.internal.nextLayerTimer.IN := TRUE;
task.internal.nextLayerTimer(); 
			
END_STEP
(* @SFCMAXTIME := '' *)
(* @SFCMINTIME := '' *)
(* @SFCCOMMENT := '' *)
EXIT_ACTION
(* @LANGUAGE := 'st' *)
task.internal.nextLayerTimer.IN := FALSE;
task.internal.nextLayerTimer();
(* TODO: Insert Program *)
END_ACTION
TRANSITION FROM wait TO UpdateNextLayer:=
task.internal.nextLayerTimer.Q
END_TRANSITION
(* @SFCISJUMP := 'UpdateNextLayer' *)
END_PROGRAM
