    <tu tuid="MQTT_SW_CONNECTION_ERROR_AL1400.AdditionalInfo">
      <tuv xml:lang="en">
        <seg>Check Server and MQTT Configuration parameters.</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_CONNECTION_ERROR_AL1400.Message">
      <tuv xml:lang="en">
        <seg>MQTT Broker Connection Error. </seg>
      </tuv>
