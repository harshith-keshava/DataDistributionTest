        <seg>First Active Condition : {&amp;inhibitReason}</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_PUBLISH_INHIBIT_AL1401.Message">
      <tuv xml:lang="en">
        <seg>MQTT Publish inhibited</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_JSON_READ_ERROR_AL1402.AdditionalInfo">
      <tuv xml:lang="en">
        <seg>Verify PLC data structure to be published</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_JSON_READ_ERROR_AL1402.Message">
      <tuv xml:lang="en">
