        <seg>Verify Broker connection is stable</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_JSON_WRITE_ERR_AL1406.Message">
      <tuv xml:lang="en">
        <seg>Failed to write MQTT data to PLC data structure. Topic- {&amp;MQTT_SW_JSON_WRITE_ERR_AL1406.snippet}</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_JSON_WRITE_ERR_AL1406.AdditionalInfo">
