        <seg>{&amp;MQTT_SW_DATA_PUBLISH_ERR_AL1403.snippet}</seg>
      </tuv>
    </tu>
    <tu tuid="MQTT_SW_DATA_PUBLISH_ERR_AL1403.Message">
      <tuv xml:lang="en">
